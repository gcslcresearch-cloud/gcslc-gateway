# GCSLC Sovereign Gateway — copy to .env locally; in Hugging Face / Streamlit Cloud use the
# "Secrets" / "Environment variables" UI with the SAME variable names (do not commit real values).

# --- Streamlit / HTTPS (fixes mixed-content for embedded payment iframes on live deploys) ---
# GCSLC_DASHBOARD_BASE_URL=https://your-space.hf.space

# --- Paystack / Flutterwave (server-side init; keys stay in Secrets) ---
# GCSLC_PAYSTACK_SECRET_KEY=
# GCSLC_FLUTTERWAVE_SECRET_KEY=
# GCSLC_FLW_REDIRECT_URL=https://your-space.hf.space/
# Optional static hosted checkout if API init is unavailable:
# GCSLC_PAYSTACK_CHECKOUT_URL=
# GCSLC_FLUTTERWAVE_CHECKOUT_URL=
# GCSLC_PAYMENT_PUBLIC_LINK=

# --- Voter DB (cloud-safe: prefer Parquet + row cap) ---
# Explicit CSV path (repo voter_db.csv is NOT auto-mounted unless set):
# GCSLC_VOTER_DB=/path/to/voter_db.csv
# Preferred for Spaces: compressed Parquet (smaller RAM / faster head reads):
# GCSLC_VOTER_DB_PARQUET=/path/to/voter_db.parquet
# Cap rows loaded into RAM for UI blocks (default 256; raise only if needed):
# GCSLC_VOTER_DB_MAX_ROWS=256
# Kaduna data lake root (defaults to ~/Desktop/KADUNA_Data_2027):
# GCSLC_KADUNA_DATA_2027=/path/to/KADUNA_Data_2027

# --- WhatsApp / “0809” strike delivery (optional; use Secrets in cloud) ---
# Twilio WhatsApp (From/To are whatsapp:+E164)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# GCSLC_STRIKE_MEDIA_PUBLIC_URL=https://your-cdn.example.com/assets/hospital.png

# Whapi.cloud (paths vary — set from your Whapi dashboard)
# GCSLC_WHAPI_TOKEN=
# GCSLC_WHAPI_BASE=https://gate.whapi.cloud
# GCSLC_WHAPI_SEND_PATH=/messages/text

# --- Emergency terminal override (file trigger next to app) ---
# Writes JSON to .gcslc_emergency_override.json — see cien_kaduna_2027.py
