# GCSLC Sovereign Gateway — copy to .env locally; in Hugging Face / Streamlit Cloud use the
# "Secrets" / "Environment variables" UI with the SAME variable names (do not commit real values).

# --- Streamlit / HTTPS (fixes mixed-content for embedded payment iframes on live deploys) ---
# GCSLC_DASHBOARD_BASE_URL=https://your-space.hf.space

# --- Wallet / strike lattice (no hardcoded ₦ amount in app — set here or in Streamlit Secrets) ---
# GCSLC_WALLET_STRIKE_TOPUP_NGN=50000
# GCSLC_STRIKE_NODES_ARMED_COUNT=12765

# --- Paystack / Flutterwave (server-side init; keys stay in Secrets) ---
# GCSLC_PAYSTACK_SECRET_KEY=
# Alias (HF Secrets): same value as PAYSTACK_SECRET_KEY — app accepts either name.
# GCSLC_PAYSTACK_SECRET=
# GCSLC_FLUTTERWAVE_SECRET_KEY=
# GCSLC_FLW_REDIRECT_URL=https://your-space.hf.space/
# Optional static hosted checkout if API init is unavailable:
# GCSLC_PAYSTACK_CHECKOUT_URL=
# GCSLC_FLUTTERWAVE_CHECKOUT_URL=
# GCSLC_PAYMENT_PUBLIC_LINK=
# Optional universal integration keys (dashboard prefers GCSLC_*; HF may use unprefixed aliases):
# GCSLC_PAYMENT_GATEWAY_KEY=
# GCSLC_TERMII_API_KEY=

# --- Voter DB (cloud-safe: prefer Parquet + row cap) ---
# Explicit CSV path (repo voter_db.csv is NOT auto-mounted unless set):
# GCSLC_VOTER_DB=/path/to/voter_db.csv
# Preferred for Spaces: compressed Parquet (smaller RAM / faster head reads):
# GCSLC_VOTER_DB_PARQUET=/path/to/voter_db.parquet
# Cap rows loaded into RAM for UI blocks (default 256; raise only if needed):
# GCSLC_VOTER_DB_MAX_ROWS=256
# Private HTTPS download (presigned S3 / direct link) — avoids committing large DB to GitHub:
# GCSLC_VOTER_DB_HTTPS_URL=https://your-bucket.s3.amazonaws.com/...presigned...
# Optional bearer if your link requires it:
# GCSLC_VOTER_DB_DOWNLOAD_BEARER=
# Kaduna data lake root (defaults to ~/Desktop/KADUNA_Data_2027):
# GCSLC_KADUNA_DATA_2027=/path/to/KADUNA_Data_2027

# --- WhatsApp / “0809” strike delivery (optional; use Secrets in cloud) ---
# Gateway: twilio | whapi
# GCSLC_WHATSAPP_GATEWAY=twilio
# Max sends per Streamlit request (use a worker for full 12,765):
# GCSLC_STRIKE_DELIVERY_MAX_PER_CALL=50
# Comma-separated priority WhatsApp destinations (10 command lines):
# GCSLC_PRIORITY_WHATSAPP_NUMBERS=whatsapp:+234...,whatsapp:+234...
# Twilio WhatsApp (From/To are whatsapp:+E164)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional alias (0809 integration naming):
# GCSLC_0809_WHATSAPP_FROM=whatsapp:+234...
# GCSLC_STRIKE_MEDIA_PUBLIC_URL=https://your-cdn.example.com/assets/1004079752.png

# Whapi.cloud (paths vary — set from your Whapi dashboard)
# GCSLC_WHAPI_TOKEN=
# GCSLC_0809_API_TOKEN=
# GCSLC_WHAPI_BASE=https://gate.whapi.cloud
# GCSLC_WHAPI_SEND_PATH=/messages/text

# --- Emergency terminal override (file trigger next to app) ---
# Writes JSON to .gcslc_emergency_override.json — see cien_kaduna_2027.py

# --- Cloud deploy: assets + persistence + outbound webhook ---
# Mount/copy `assets/` (e.g. 1004079752.png) — or point the app at a volume:
# GCSLC_ASSETS_DIR=/app/assets
# Public URL prefix for WhatsApp copy (CDN / Space static):
# GCSLC_ASSETS_PUBLIC_PREFIX=https://your-space.hf.space/static
# Wallet + nodal progress JSON (default: .cache/gcslc_chairman_state.json under app root):
# GCSLC_STATE_JSON_PATH=/data/gcslc_chairman_state.json
# GCSLC_PERSISTENCE_ENABLED=1
# Outbound integration (Whapi/Twilio proxy on your own HTTPS endpoint — callable from HF egress):
# GCSLC_CLOUD_WEBHOOK_URL=https://your-api.example.com/gcslc/inbound
# GCSLC_CLOUD_WEBHOOK_TOKEN=
# Optional: POST when payment strike is armed (requires URL above):
# GCSLC_CLOUD_WEBHOOK_ON_PAYMENT=1

# --- Outbound email (scripts/send_sovereign_zenith_smtp.mjs) — do not commit real secrets ---
# SendGrid (preferred for serverless):
# SENDGRID_API_KEY=
# MAIL_FROM=noreply@your-verified-domain.com
# MAIL_TO=gcslc.research@gmail.com
# Or SMTP (transactional / Gmail app password):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# MAIL_TO=gcslc.research@gmail.com

# --- WhatsApp dual nodal handshake (Advisory Hub · Termii vs Executive) ---
# WHATSAPP_BUSINESS_NODE=+2347039139439
# CHAIRMAN_DIRECT_NODE=+2348099111515

# --- Triple Cloud V28 · Microsoft Azure API Management · Kaduna LGA · Telegram Gateway ---
# APIM forwards: set subscription key + optional trace; map to HTTP headers Ocp-Apim-Subscription-Key / Ocp-Apim-Trace.
# GCSLC_AZURE_APIM_SUBSCRIPTION_KEY=
# GCSLC_AZURE_APIM_TRACE=0
# HTTPS endpoints (backend / APIM operations) — wire into sovereign HTML via window.GCSLC_TRIPLE_CLOUD_V28 or server inject:
# GCSLC_TRIPLE_CLOUD_BRIDGE_URL=https://your-apim.azure-api.net/gcslc/lga-sync
# GCSLC_AZURE_AUDIT_WEBHOOK_URL=https://your-apim.azure-api.net/gcslc/audit
# GCSLC_TELEGRAM_GATEWAY_URL=https://your-apim.azure-api.net/gcslc/telegram-send
# Optional: embed Kaduna / LGA Google Map iframe src after triple-cloud ping (public embed URL):
# GCSLC_GOOGLE_MAPS_EMBED_URL=

# =============================================================================
# Vercel — gcslc-gateway (index.html + /api/* serverless)
# Set in: Vercel Project → Settings → Environment Variables (Production / Preview).
# Never commit real secrets; static HTML meta may mirror vault key for client-side gates.
# =============================================================================
# Primary sovereign access secret (must match NAFC / vault UI when rotating):
# GCSLC_SOVEREIGN_VAULT_KEY=<set-in-vercel-dashboard>
# Alias used by some scripts — same value as above:
# GCSLC_CHAIRMAN_KEY=<set-in-vercel-dashboard>
# Executive & personal WhatsApp — E.164 digits only (no + prefix):
# GCSLC_EXECUTIVE_WHATSAPP_E164=2347039139439
# GCSLC_PERSONAL_WHATSAPP_E164=2348099111515
# Documented API paths (handlers live in repo under /api; Termii webhooks point here):
# GCSLC_API_HANDSHAKE_URL=https://gcslc-gateway.vercel.app/api/handshake
# GCSLC_API_HANDSHAKE_PATH=/api/handshake
# Termii / SMS — server-side only; do not expose in client bundles:
# GCSLC_TERMII_API_KEY=
# GCSLC_TERMII_SENDER_ID=
# GCSLC_TERMII_BASE_URL=https://api.ng.termii.com

# --- V203 — Vercel serverless: HttpOnly sovereign session mint (/api/sovereign/mint-session) ---
# Must match the Chairman Sovereign Key used in the NAFC console (never commit the real value).
# GCSLC_SOVEREIGN_KEY=Galadima@2026#
